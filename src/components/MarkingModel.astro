---
interface RubricBands {
  hd: string;
  d: string;
  cr: string;
  p: string;
  f: string;
}

interface WeightedMarking {
  mode: "weighted";
  criteria: { name: string; weight: number; bands?: RubricBands }[];
}

interface HolisticMarking {
  mode: "holistic";
  description: string;
  bands?: RubricBands;
}

interface Props {
  marking: WeightedMarking | HolisticMarking;
}

const { marking } = Astro.props;

const bandLabels: { key: keyof RubricBands; label: string; range: string }[] = [
  { key: "hd", label: "HD", range: "80–100%" },
  { key: "d", label: "D", range: "70–79%" },
  { key: "cr", label: "Cr", range: "60–69%" },
  { key: "p", label: "P", range: "50–59%" },
  { key: "f", label: "F", range: "0–49%" },
];
---

<section aria-labelledby="how-marked">
  <h2 id="how-marked">How it is marked</h2>
  {marking.mode === "holistic" ? (
    <p>{marking.description}</p>
  ) : (
    <table>
      <thead><tr><th scope="col">Criterion</th><th scope="col">Weight</th></tr></thead>
      <tbody>
        {marking.criteria.map((criterion) => (
          <tr><td>{criterion.name}</td><td>{criterion.weight}%</td></tr>
        ))}
      </tbody>
    </table>
  )}

  {
    marking.mode === "weighted" && marking.criteria.some((c) => c.bands) && (
      <>
        <h3>Rubric</h3>
        {marking.criteria
          .filter((criterion) => criterion.bands)
          .map((criterion) => (
            <table>
              <caption>
                {criterion.name} <em>({criterion.weight}% of this assessment)</em>
              </caption>
              <thead>
                <tr>
                  {bandLabels.map((b) => (
                    <th scope="col">
                      {b.label} <span>({b.range})</span>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                <tr>
                  {bandLabels.map((b) => (
                    <td>{criterion.bands![b.key]}</td>
                  ))}
                </tr>
              </tbody>
            </table>
          ))}
      </>
    )
  }

  {
    marking.mode === "holistic" && marking.bands && (
      <>
        <h3>Rubric</h3>
        <table>
          <thead>
            <tr>
              {bandLabels.map((b) => (
                <th scope="col">
                  {b.label} <span>({b.range})</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            <tr>
              {bandLabels.map((b) => (
                <td>{marking.bands![b.key]}</td>
              ))}
            </tr>
          </tbody>
        </table>
      </>
    )
  }
</section>
