---
interface Props {
  quizId: string;
  questions: { question: string; answer: string }[];
}

const { quizId, questions } = Astro.props;
---

<ol class="quiz-questions">
  {
    questions.map((q, i) => (
      <li class="quiz-question" data-quiz-question>
        <p class="quiz-question-text">{q.question}</p>
        <form class="quiz-form">
          <label>
            Your answer
            <input type="text" name={`quiz-${quizId}-${i}`} autocomplete="off" />
          </label>
          <button type="submit">Reveal answer</button>
        </form>
        <p class="quiz-answer" hidden>
          <strong>Answer:</strong> {q.answer}
        </p>
      </li>
    ))
  }
</ol>

<script>
  for (const item of document.querySelectorAll<HTMLElement>("[data-quiz-question]")) {
    if (item.dataset.quizWired) continue;
    item.dataset.quizWired = "true";
    const form = item.querySelector<HTMLFormElement>(".quiz-form");
    const answer = item.querySelector<HTMLElement>(".quiz-answer");
    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      if (!answer) return;
      answer.hidden = false;
      const input = form.querySelector("input");
      if (input) input.disabled = true;
      const button = form.querySelector("button");
      if (button) button.disabled = true;
    });
  }
</script>

<style>
  .quiz-questions {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .quiz-question {
    border-block-start: 1px dashed var(--at-border, currentcolor);
    padding-block-start: 1rem;
  }

  .quiz-question-text {
    font-weight: 500;
  }

  .quiz-form {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.5rem;
  }

  .quiz-form label {
    display: flex;
    flex-direction: column;
    font-size: 0.9rem;
    flex: 1 1 16rem;
  }

  .quiz-answer {
    margin-block-start: 0.5rem;
    padding-block-start: 0.5rem;
    border-block-start: 1px dashed var(--at-border, currentcolor);
  }
</style>
